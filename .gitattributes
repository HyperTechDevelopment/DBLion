# Keep line endings deterministic across Linux and Windows checkouts (CI parity).
* text=auto eol=lf

# Binaries must never be normalised.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.zip binary

# Windows tooling that expects CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
